{
  "name": "luna-core",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "build": {
    "command": "node scripts/write-build-meta.mjs"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "5 20 * * *",
      "10,40 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEST_STATE",
        "class_name": "QuestStateStore"
      }
    ]
  },
  "exports": {
    "QuestStateStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
