{
  "name": "luna-core",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEST_STATE",
        "class_name": "QuestStateStore"
      }
    ]
  },
  "exports": {
    "QuestStateStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
